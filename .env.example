# Placeholders only. Never commit real credentials or tokens.
# Copy this file to '.env' in the repository root. The API, the worker, the EF
# Core design-time tools and the integration tests each search upward from their
# output directory for the nearest '.env' and apply what the process environment
# does not already define, so an exported or injected variable always wins
# (ADR-041). A declaration is KEY=VALUE; there is no inline comment syntax,
# because a password may contain '#'.
SIRKADIYEN_DATABASE__CONNECTION_STRING=Host=localhost;Port=5432;Database=sirkadiyen;Username=sirkadiyen;Password=change-me
# Database integration tests skip themselves unless this is set. The database is
# dropped and re-migrated on every run, so never point it at a real database.
SIRKADIYEN_TEST_DATABASE__CONNECTION_STRING=Host=localhost;Port=5432;Database=sirkadiyen_tests;Username=sirkadiyen;Password=change-me
SIRKADIYEN_REDIS__CONNECTION_STRING=localhost:6379
SIRKADIYEN_GOOGLE__CLIENT_ID=replace-with-google-client-id
SIRKADIYEN_GOOGLE__CLIENT_SECRET=replace-with-google-client-secret
# Unattended source access. The grant must carry both read-only scopes —
# spreadsheets.readonly and drive.readonly — because sources are published as
# Sheets and as Drive files (ADR-083). A refresh token is fixed at the moment it
# is issued, so one minted for Sheets alone must be re-issued.
SIRKADIYEN_GOOGLE__SOURCE_REFRESH_TOKEN=replace-with-source-refresh-token
# Browser Google Identity Services client. The backend validates its ID
# credentials against this audience; no client secret is needed for sign-in.
# Keep end-user identity configuration separate from unattended source access.
SIRKADIYEN_GOOGLE__AUTH_CLIENT_ID=replace-with-browser-google-client-id
# Calendar authorization exchanges a user's one-time authorization code for a
# refresh token, so unlike sign-in it is a confidential client and needs a secret.
# It may reuse the browser client above, but is configured separately so the secret
# is never implied by the public sign-in client. The redirect URI stays
# "postmessage" while the frontend obtains the code with Google's popup code flow.
SIRKADIYEN_GOOGLE__CALENDAR_CLIENT_ID=replace-with-calendar-google-client-id
SIRKADIYEN_GOOGLE__CALENDAR_CLIENT_SECRET=replace-with-calendar-google-client-secret
SIRKADIYEN_GOOGLE__CALENDAR_REDIRECT_URI=postmessage
# Shared Data Protection key ring for the refresh token (ADR-058). The worker
# decrypts what the API encrypted, so both must persist keys to one shared, backed-up
# location and use the same application name. Leave unset to use a per-user default
# path (fine for a single-host dev machine, not for multi-instance production).
SIRKADIYEN_DATAPROTECTION__KEY_RING_PATH=
# Base64 for at least 32 random bytes. Rotating it invalidates every unredeemed
# code because only keyed hashes are stored.
SIRKADIYEN_LICENSING__HASH_KEY=replace-with-base64-encoded-random-key
# Alternative to the three OAuth values above. A service account asserts its own
# scopes, so it needs no re-consent for Drive — but the Drive API must be enabled
# on its Cloud project, and each Drive-published document must be shared with the
# account's address.
SIRKADIYEN_GOOGLE__SERVICE_ACCOUNT_CREDENTIAL_PATH=path-to-service-account-json
SIRKADIYEN_PARSER__BASE_URL=http://localhost:8000
SIRKADIYEN_PARSER__TIMEOUT=00:02:00
# The worker hosts health endpoints on an internal-only listener. The worker uses
# HEALTH_URL to bind Kestrel; the API uses BASE_URL to probe it. Keep both on
# loopback for a same-host deployment, or use a private container-network address.
SIRKADIYEN_WORKER__HEALTH_URL=http://127.0.0.1:5081
SIRKADIYEN_WORKER__BASE_URL=http://127.0.0.1:5081
# How long a parse run may stay open before a later cycle treats it as abandoned
# by a worker that died mid-parse and reopens it (ADR-050). Must stay well above
# SIRKADIYEN_PARSER__TIMEOUT, or a slow but healthy parse is recovered while it
# is still running.
SIRKADIYEN_PARSER__STALE_RUN_TIMEOUT=00:30:00
# The schedule source catalog, read by the worker at startup and read AND
# written by the API's administration panel (ADR-113). In development this is
# the repository file, resolved against each host's content root. On a deployed
# server it is an absolute path outside both release directories
# (/srv/sirkadiyen/shared/config/schedule-sources.json), set by the systemd units, so
# an administrative edit is not reverted by the next deployment.
SIRKADIYEN_SOURCES__CATALOG_PATH=config/schedule-sources.json
# The published faculty student lists the profile lookup searches (ADR-132).
# Read by the API only, and read-only: it holds locations and column layouts, not
# people. Unlike the source catalog nothing writes it, so the repository file is
# a fine target on a deployed server too.
#
# Reading the lists themselves uses the SIRKADIYEN_GOOGLE source credential
# above, which the API now needs as well as the worker. Without it every list is
# reported as unreadable and onboarding continues by hand.
SIRKADIYEN_ROSTERS__CATALOG_PATH=config/student-rosters.json
SIRKADIYEN_POLLING__TIME_ZONE_ID=Europe/Istanbul
SIRKADIYEN_POLLING__DAYTIME_START=07:00
SIRKADIYEN_POLLING__LATE_AFTERNOON_START=16:00
SIRKADIYEN_POLLING__NIGHT_START=21:00
SIRKADIYEN_POLLING__DAYTIME_INTERVAL=00:15:00
SIRKADIYEN_POLLING__LATE_AFTERNOON_INTERVAL=00:25:00
SIRKADIYEN_POLLING__NIGHT_INTERVAL=00:45:00
SIRKADIYEN_POLLING__WEEKEND_INTERVAL=01:00:00
# Revision validation thresholds (ADR-029). A revision is held for review when
# any error-severity rule fires; only an empty revision is rejected outright.
# The deletion rule needs both the share AND the absolute count to be exceeded.
SIRKADIYEN_VALIDATION__MAXIMUM_DELETION_SHARE=0.20
SIRKADIYEN_VALIDATION__MINIMUM_DELETION_COUNT=10
SIRKADIYEN_VALIDATION__LOW_CONFIDENCE_THRESHOLD=0.50
SIRKADIYEN_VALIDATION__MINIMUM_LESSON_MINUTES=10
SIRKADIYEN_VALIDATION__MAXIMUM_LESSON_MINUTES=600
SIRKADIYEN_VALIDATION__MAXIMUM_TOLERATED_OVERLAPS=1
SIRKADIYEN_VALIDATION__ACADEMIC_YEAR_GRACE_DAYS=30

# Semantic diff dispatch gate (ADR-040). A diff over these limits is held and
# reaches no calendar. Secondary-matching thresholds are deliberately not
# configurable; they are a matching rule decided in ADR-035.
SIRKADIYEN_DIFF__MAXIMUM_DELETION_SHARE=0.20
SIRKADIYEN_DIFF__MINIMUM_DELETION_COUNT=10

# Initial calendar synchronization (ADR-058). One cycle advances this many users'
# syncs, writing at most this many events per user before deferring the rest to a
# later cycle, so a large first load stays within Calendar quota. The summary and
# time zone are given to each user's dedicated calendar (ADR-024).
SIRKADIYEN_SYNC__CONNECTION_BATCH_SIZE=5
SIRKADIYEN_SYNC__EVENTS_PER_CONNECTION=100
SIRKADIYEN_SYNC__CALENDAR_SUMMARY=Sirkadiyen
SIRKADIYEN_SYNC__CALENDAR_TIME_ZONE_ID=Europe/Istanbul
# Calendar work is independent from the slower source polling clock. A quota-yielded
# pass resumes after the catch-up interval; an otherwise idle worker checks for newly
# queued initial sync/reconciliation/diff work after the idle-check interval.
SIRKADIYEN_SYNC__CALENDAR_CATCH_UP_INTERVAL=00:00:05
SIRKADIYEN_SYNC__CALENDAR_IDLE_CHECK_INTERVAL=00:00:05

# Incremental calendar dispatch (ADR-059/065). One cycle admits this many dispatchable
# diffs and attempts at most this many per-user Calendar mutations for each admitted diff.
# A partial pass remains Pending without counting as a failure; its completed ledger work
# falls out of the next plan. A transient Google failure backs off exponentially from the
# base delay and gives up (awaiting an operator) after this many attempts.
SIRKADIYEN_SYNC__DIFF_DISPATCH_BATCH_SIZE=10
SIRKADIYEN_SYNC__CALENDAR_OPERATIONS_PER_DIFF_BATCH=100
SIRKADIYEN_SYNC__MAX_DISPATCH_ATTEMPTS=5
SIRKADIYEN_SYNC__DISPATCH_RETRY_BASE_DELAY_SECONDS=30

# Calendar reconciliation after re-authorization (ADR-060). Each user replays only already
# dispatched Ready/Released semantic diffs, in cursor order. The per-user limit always yields
# between complete diffs; it never splits a diff's deletion authority.
SIRKADIYEN_SYNC__RECONCILIATION_CONNECTION_BATCH_SIZE=5
SIRKADIYEN_SYNC__RECONCILIATION_DIFFS_PER_CONNECTION=10
SIRKADIYEN_SYNC__INVENTORY_CONNECTION_BATCH_SIZE=5
SIRKADIYEN_SYNC__INVENTORY_INTERVAL=1.00:00:00

# Profile-change re-synchronization (ADR-096). When a student's academic profile changes the
# audience it resolves, one cycle converges this many users' calendars, attempting at most this
# many Calendar mutations each. Reaching the budget leaves the request pending without back-off;
# the mapping ledger is the progress record, so the next pass plans only what remains.
SIRKADIYEN_SYNC__PROFILE_RESYNC_CONNECTION_BATCH_SIZE=5
SIRKADIYEN_SYNC__PROFILE_RESYNC_OPERATIONS_PER_CONNECTION=100

# Snapshot payload retention (ADR-044). The first snapshot of the source's
# active academic year, the latest source content, and any snapshot still needed
# by an absent/running/failed parse run are always kept.
SIRKADIYEN_RETENTION__SNAPSHOT_RECENT_DAYS=10
SIRKADIYEN_RETENTION__SNAPSHOT_BATCH_SIZE=50

SIRKADIYEN_SECURITY__TOKEN_ENCRYPTION_KEY=replace-with-a-development-only-key

# Logging. EF Core logs every executed SQL statement at Information, which buries
# the worker's own logs and any failures. Keep our logs at Information but raise
# EF's command logging to Warning so only failing commands are shown. These bind
# through the standard configuration "Logging" section; the env-var provider maps
# '__' to ':' and preserves the dotted category name.
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.EntityFrameworkCore.Database.Command=Warning
