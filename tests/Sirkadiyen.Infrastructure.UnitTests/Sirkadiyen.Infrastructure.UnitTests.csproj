<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Sirkadiyen.Application/Sirkadiyen.Application.csproj" />
    <ProjectReference Include="../../src/Sirkadiyen.Contracts/Sirkadiyen.Contracts.csproj" />
    <ProjectReference Include="../../src/Sirkadiyen.Infrastructure/Sirkadiyen.Infrastructure.csproj" />
    <ProjectReference Include="../../src/Sirkadiyen.Worker/Sirkadiyen.Worker.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../config/schedule-sources.json" Link="fixtures/schedule-sources.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../config/student-rosters.json" Link="fixtures/student-rosters.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../sheets/donem-1-tr/xlsx/2025-2026 D1 Türkçe Tıp Ders Programı.xlsx" Link="fixtures/g1-tr-annual.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../sheets/donem-1-tr/xlsx/2025-2026 Dönem 1 Türkçe Uygulama Tablosu (1).xlsx" Link="fixtures/g1-tr-practice.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      Matched by pattern on purpose: the file name on disk writes its İ as a
      decomposed I plus a combining dot, and a literal path here would be a
      different string that MSBuild cannot find. The pattern matches one file.
    -->
    <None Include="../../sheets/donem-2-tr/2. SINIF SALON GRUP SAATLER* GÜZ.docx" Link="fixtures/g2-anatomy-autumn.docx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="../../sheets/donem-2-tr/Dönem 2 Beceri uygulama takvimi güz.docx" Link="fixtures/g2-vertical-autumn.docx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      Matched by pattern for the same reason as the anatomy document above. This
      workbook carries a date written in Excel's long-date format, whose
      `[$-F800]` locale prefix the converter must not read as a currency.
    -->
    <None Include="../../sheets/donem-3-tr-A/*A GRUBU UYGULAMA TABLOSU*2026-2027*.xlsx" Link="fixtures/g3-tr-a-faculty.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
