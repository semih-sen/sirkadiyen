<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="../Sirkadiyen.Application/Sirkadiyen.Application.csproj" />
    <ProjectReference Include="../Sirkadiyen.Contracts/Sirkadiyen.Contracts.csproj" />
    <ProjectReference Include="../Sirkadiyen.Infrastructure/Sirkadiyen.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The endpoint helpers that parse and shape query input are internal: they are
      implementation detail of the routes, not API surface. They still carry rules worth
      pinning down on their own, such as refusing a malformed selector pair rather than
      silently widening the query it describes.
    -->
    <InternalsVisibleTo Include="Sirkadiyen.Api.UnitTests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The vault agent's standing rules, appended to its system prompt on every run (ADR-168). -->
    <None Update="Vault/AgentInstructions.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!--
      Pinned above the 2.0.0 that Microsoft.AspNetCore.OpenApi 10.0.10 pulls in.
      That version carries GHSA-v5pm-xwqc-g5wc, and this repository treats NuGet
      audit warnings as errors, so the transitive reference fails the build.
      Remove the pin once the OpenApi package depends on a patched version.
    -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
  </ItemGroup>
</Project>
