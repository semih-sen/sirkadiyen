[Unit]
Description=Sirkadiyen worker (polling, parsing, calendar dispatch)
After=network-online.target postgresql.service redis-server.service sirkadiyen-parser.service
Wants=network-online.target
# The worker calls the parser over SIRKADIYEN_PARSER__BASE_URL.
Wants=sirkadiyen-parser.service

[Service]
# Type=exec, not notify: the hosts do not reference
# Microsoft.Extensions.Hosting.Systemd, so nothing would ever send READY=1 and
# systemd would time the start out. Add that package and UseSystemd() to switch.
Type=exec
User=sirkadiyen
Group=sirkadiyen

WorkingDirectory=/srv/sirkadiyen/worker/current
ExecStart=/srv/sirkadiyen/worker/current/Sirkadiyen.Worker

EnvironmentFile=/srv/sirkadiyen/shared/env/common.env
EnvironmentFile=/srv/sirkadiyen/shared/env/worker.env
Environment=DOTNET_ENVIRONMENT=Production
Environment=ASPNETCORE_ENVIRONMENT=Production

# The running source catalog lives in the shared directory, not in this release:
# the admin panel edits that file, and a catalog inside the release directory
# would be replaced by the next deployment without leaving a trace.
#
# Since ADR-138 the worker also INSTALLS the catalog its own release shipped into
# that file at startup, through the same service the panel uses - validated, with
# the source rows moved in one transaction, and recorded in the catalog history as
# a Deployment revision carrying the document it replaced. The repository is
# therefore the source of truth and the panel is how to change the catalog
# quickly; a panel edit that is never committed is replaced by the next
# deployment and is restorable from that revision.
Environment=SIRKADIYEN_SOURCES__CATALOG_PATH=/srv/sirkadiyen/shared/config/schedule-sources.json

Restart=always
RestartSec=5
# A parse run in flight deserves a chance to finish; the stale-run timeout only
# reopens abandoned runs after 30 minutes, so a slow stop is cheap and a hard
# kill is not.
TimeoutStopSec=120

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/sirkadiyen/shared/dataprotection-keys
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
