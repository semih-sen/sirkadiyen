[Unit]
Description=Sirkadiyen API (ASP.NET Core, Kestrel)
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
# Type=exec, not notify: the hosts do not reference
# Microsoft.Extensions.Hosting.Systemd, so nothing would ever send READY=1 and
# systemd would time the start out. Add that package and UseSystemd() to switch.
Type=exec
User=sirkadiyen
Group=sirkadiyen

# The symlink is swapped atomically by sirkadiyen-activate; systemd resolves it
# at each start, so a restart is what picks up a new release.
WorkingDirectory=/srv/sirkadiyen/api/current
ExecStart=/srv/sirkadiyen/api/current/Sirkadiyen.Api

# DotEnvFile.Load() only fills in what the process environment does not already
# define (ADR-041), so these injected values always win and no .env file is
# deployed to the server.
EnvironmentFile=/srv/sirkadiyen/shared/env/common.env
EnvironmentFile=/srv/sirkadiyen/shared/env/api.env
Environment=DOTNET_ENVIRONMENT=Production
Environment=ASPNETCORE_ENVIRONMENT=Production

# The schedule source catalog the admin panel edits (ADR-114). It is the same
# file the worker loads, and it lives outside both release directories because
# an administrative edit must survive the next deployment.
Environment=SIRKADIYEN_SOURCES__CATALOG_PATH=/srv/sirkadiyen/shared/config/schedule-sources.json

# The published student lists the profile lookup searches (ADR-132). Nothing
# writes it, but it sits beside the source catalog so a corrected column layout
# can be deployed on its own. Reading the lists themselves uses the
# SIRKADIYEN_GOOGLE source credential common.env already supplies, which the API
# now uses as well as the worker.
Environment=SIRKADIYEN_ROSTERS__CATALOG_PATH=/srv/sirkadiyen/shared/config/student-rosters.json

Restart=always
RestartSec=5
TimeoutStopSec=30

# Hardening. The service writes to the shared Data Protection key ring, which
# the API and the worker must share (ADR-058), and to the schedule source
# catalog directory, which the administration panel edits (ADR-114). Under
# ProtectSystem=strict the whole file system is read-only unless it is listed
# here, so omitting the catalog directory is what "read-only" looks like in the
# panel - not a permission bit.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/sirkadiyen/shared/dataprotection-keys
ReadWritePaths=/srv/sirkadiyen/shared/config
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
